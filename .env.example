# Copy to .env and adjust. Nothing in here is a secret: passwords live in
# ./secrets (see scripts/init-secrets.sh), the webhook URL is the one
# exception and .env is gitignored for that reason.

COMPOSE_PROJECT_NAME=gsp
MONGO_DB=gsp

# Image to deploy. Locally built images are just "gsp-notes".
APP_IMAGE=gsp-notes

HTTP_PORT=8080
HTTPS_PORT=8443
PUBLIC_URL=https://localhost:8443

# Backups
BACKUP_DIR=./backups/local
LOCAL_RETENTION_HOURS=48
# Real off-site copy (rclone remote, configured with `rclone config`):
# OFFSITE_REMOTE=r2:gsp-backups/mongo
# Simulated second location if you have no bucket:
OFFSITE_DIR=./backups/offsite-sim

# Path to the backup private key. Only needed when RESTORING.
# AGE_IDENTITY_FILE=/home/you/.config/gsp/backup-identity.txt

# Alerts (Discord or Slack incoming webhook)
ALERT_WEBHOOK_URL=
